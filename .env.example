# Required for every protected API route. Generate a long random value and store
# it in Secret Manager in production. This placeholder is not a usable secret.
APP_API_TOKEN=replace-with-a-long-random-token

# Local mode (default): jobs and PDFs are stored under DATA_DIR.
DATA_DIR=./data
# Optional. AppSheet-style paths in local mode must resolve inside this folder.
# LOCAL_INPUT_DIR=./data/inputs
MAX_UPLOAD_BYTES=31457280

# Google Drive mode: set both folder IDs and grant the runtime service account
# access to those folders. Leave blank to use local-development storage.
DRIVE_UPLOAD_FOLDER_ID=
DRIVE_OUTPUT_FOLDER_ID=

# Google Sheets mode: spreadsheet ID containing a tab named AttendanceReportJobs.
# Leave blank to use local SQLite job tracking.
SHEETS_SPREADSHEET_ID=
SHEETS_JOBS_TAB=AttendanceReportJobs

# Optional for local service-account-key development only. On Cloud Run, attach
# a service account and leave this blank to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional durable Cloud Tasks processing. Configure all five values together.
# Requires Drive and Sheets mode. PUBLIC_BASE_URL must be the Cloud Run HTTPS URL.
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
PUBLIC_BASE_URL=
TASK_INVOKER_SERVICE_ACCOUNT=
